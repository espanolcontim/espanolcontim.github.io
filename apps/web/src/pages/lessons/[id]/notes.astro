---
import LessonHeader from '../../../features/lessons/LessonHeader.astro'
import LessonNext from '../../../features/lessons/LessonNext.astro'
import { Locked } from '../../../features/lessons/Locked.tsx'
import { lessonPath } from '../../../features/lessons/navigation.ts'
import { NotesContent } from '../../../features/lessons/NotesContent.tsx'
import { loadLesson, sectionStaticPaths } from '../../../features/lessons/page.ts'
import PaidNotes from '../../../features/lessons/PaidNotes.tsx'
import Page from '../../../app/Page.astro'

export const getStaticPaths = () => sectionStaticPaths('notes')

const { meta, body, lessons, channel } = await loadLesson(Astro.params.id)
const inside = 'теория с транскрипцией, сводные таблицы, диалоги и новые слова'
---

<Page
  currentLesson={meta.id}
  noindex={!body.notes}
  title={`Конспект урока ${meta.number}. ${meta.title}`}
  description={`Конспект урока ${meta.number} «${meta.title}»: правила, таблицы с транскрипцией, диалоги и новые слова.`}
>
  <LessonHeader meta={meta} channel={channel} section="notes" />
  {body.notes ? (
    <NotesContent notes={body.notes} />
  ) : (
    <>
      <PaidNotes client:only="react" lessonId={meta.id} inside={inside} />
      <noscript>
        <Locked inside={inside} from={lessonPath(meta.id, 'notes')} />
      </noscript>
    </>
  )}
  <LessonNext meta={meta} lessons={lessons} current="notes" />
</Page>

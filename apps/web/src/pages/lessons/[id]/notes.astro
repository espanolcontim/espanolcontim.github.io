---
import LessonHeader from '../../../features/lessons/LessonHeader.astro'
import Locked from '../../../features/lessons/Locked.astro'
import NotesContent from '../../../features/lessons/NotesContent.astro'
import { lessonStaticPaths, loadLesson } from '../../../features/lessons/page.ts'
import Page from '../../../app/Page.astro'

export const getStaticPaths = lessonStaticPaths

const { meta, body, channel } = await loadLesson(Astro.params.id)
---

<Page
  currentLesson={meta.id}
  title={`Конспект урока ${meta.number}. ${meta.title}`}
  description={`Конспект урока ${meta.number} «${meta.title}»: правила, таблицы с транскрипцией, диалоги и новые слова.`}
>
  <LessonHeader meta={meta} channel={channel} section="Конспект" />
  {body.notes ? (
    <NotesContent notes={body.notes} />
  ) : (
    <Locked inside="теория с транскрипцией, сводные таблицы, диалоги и новые слова" />
  )}
</Page>

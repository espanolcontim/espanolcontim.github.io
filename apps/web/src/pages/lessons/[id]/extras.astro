---
import { ExtrasContent } from '../../../features/lessons/ExtrasContent.tsx'
import LessonHeader from '../../../features/lessons/LessonHeader.astro'
import LessonNext from '../../../features/lessons/LessonNext.astro'
import { Locked } from '../../../features/lessons/Locked.tsx'
import { lessonPath } from '../../../features/lessons/navigation.ts'
import { loadLesson, sectionStaticPaths } from '../../../features/lessons/page.ts'
import PaidExtras from '../../../features/lessons/PaidExtras.tsx'
import Page from '../../../app/Page.astro'

export const getStaticPaths = () => sectionStaticPaths('extras')

const { meta, body, lessons, channel } = await loadLesson(Astro.params.id)
const inside =
  'живые выражения, мини-история с вопросами, фразы с характером, «Испания изнутри» и упражнения'
---

<Page
  currentLesson={meta.id}
  noindex={!body.extras}
  title={`Дополнительные материалы к уроку ${meta.number}. ${meta.title}`}
  description={`Дополнительные материалы к уроку ${meta.number} «${meta.title}»: живые выражения, мини-история и «Испания изнутри».`}
>
  <LessonHeader meta={meta} channel={channel} section="extras" />
  {body.extras ? (
    <ExtrasContent extras={body.extras} />
  ) : (
    <>
      <PaidExtras client:only="react" lessonId={meta.id} inside={inside} />
      <noscript>
        <Locked inside={inside} from={lessonPath(meta.id, 'extras')} />
      </noscript>
    </>
  )}
  <LessonNext meta={meta} lessons={lessons} current="extras" />
</Page>

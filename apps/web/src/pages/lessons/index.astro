---
import { LEVEL_LESSONS, LEVELS } from '@espanolcontim/content'
import { container } from '../../app/container.ts'
import Page from '../../app/Page.astro'
import { ACCESS_NOTE, LEVEL_NAMES } from '../../features/lessons/labels.ts'
import { lessonPath } from '../../features/lessons/navigation.ts'
import LessonMark from '../../features/review/LessonMark.astro'

const lessons = await container.lessons.list()
const levels = LEVELS.map((level) => ({
  level,
  lessons: lessons.filter((lesson) => lesson.level === level),
})).filter((group) => group.lessons.length > 0)
---

<Page
  title="Уроки"
  description="Все уроки курса «Испанский с нуля»: конспекты, дополнительные материалы и упражнения к каждому видео."
>
  <header class="page-header">
    <p class="overline">Испанский с нуля</p>
    <h1>Уроки</h1>
  </header>

  {levels.map(({ level, lessons }) => (
    <section class="level" aria-labelledby={`level-${level}`}>
      <h2 id={`level-${level}`}>
        {level} <span class="level-name">· {LEVEL_NAMES[level]}</span>
      </h2>
      {LEVEL_LESSONS[level] && (
        <p class="ru">
          Вышло {lessons.length} из {LEVEL_LESSONS[level]} уроков
        </p>
      )}
      <ol class="lessons">
        {lessons.map((lesson) => {
          const note = lesson.parts.notes && ACCESS_NOTE[lesson.parts.notes]
          return (
            <li>
              <a class="lesson" href={lessonPath(lesson.id)}>
                <span class="n">{lesson.planLesson}</span>
                <span class="title">{lesson.title}</span>
                <span class="badges">
                  <LessonMark lessonId={lesson.id} />
                  {note && <span class="pill pill--lock">{note}</span>}
                </span>
                <span class="meta">Урок {lesson.number}</span>
              </a>
            </li>
          )
        })}
      </ol>
    </section>
  ))}
</Page>

<style>
  .page-header {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .level {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 2.25rem;
  }

  .level-name {
    color: var(--text-2);
    font-weight: 600;
  }

  .lessons {
    margin: 0.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  /*
   * Отметка прогресса и пометка подписки (badges) на телефоне — строкой под
   * названием, чтобы его не сжимать; на широком экране — в той же строке.
   */
  .lesson {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    grid-template-areas:
      'n title meta'
      '. badges badges';
    gap: 0 0.75rem;
    align-items: baseline;
    padding: 0.625rem 0.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }

  .lesson:hover .title {
    color: var(--accent);
  }

  .n {
    grid-area: n;
    color: var(--accent);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .title {
    grid-area: title;
    font-weight: 700;
  }

  .meta {
    grid-area: meta;
    color: var(--text-3);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    grid-area: badges;
    gap: 0.375rem 0.75rem;
    align-items: center;
    font-size: 0.8125rem;
  }

  .badges:has(> :not([hidden])) {
    padding-top: 0.375rem;
  }

  @media (min-width: 40rem) {
    .lesson {
      grid-template-columns: 2rem minmax(0, 1fr) auto auto;
      grid-template-areas: 'n title badges meta';
    }

    .badges:has(> :not([hidden])) {
      padding-top: 0;
    }
  }
</style>

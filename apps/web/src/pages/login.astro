---
import Page from '../app/Page.astro'
import Login from '../features/auth/Login.tsx'
---

<Page
  title="Вход для подписчиков"
  noindex
  description="Вход на сайт «Español con Tim» для подписчиков Boosty: по ссылке, которая приходит на почту."
>
  <!--
    Токен из письма — сразу из адреса в history.state: скрипт стоит раньше всех остальных,
    и Метрика, которая видит адрес страницы, токен не получит. Ссылку вставили в уже открытую
    страницу входа — адрес изменился без загрузки: загружаем заново, чтобы скрипт сработал.
  -->
  <script is:inline>
    {
      const hashToken = () => new URLSearchParams(location.hash.slice(1)).get('token')
      const token = hashToken()
      if (token)
        history.replaceState({ loginToken: token }, '', location.pathname + location.search)
      addEventListener('hashchange', () => {
        if (hashToken()) location.reload()
      })
    }
  </script>

  <header class="page-header">
    <p class="overline">Boosty</p>
    <h1>Вход для подписчиков</h1>
  </header>

  <Login client:only="react" />
  <noscript>
    <p class="card">Для входа нужен включённый JavaScript.</p>
  </noscript>
</Page>

<style>
  .page-header {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.75rem;
  }
</style>

---
import { container } from '../app/container.ts'
import Page from '../app/Page.astro'
import { lessonPath } from '../features/lessons/navigation.ts'
import { BOX_LABELS } from '../features/review/labels.ts'
import Review from '../features/review/Review.tsx'
import { reviewSentences } from '../features/review/sentences.ts'

const sentences = await reviewSentences(container.lessons)
const [first] = await container.lessons.list()
const intervals = BOX_LABELS.map((label) => label.replace('через ', '')).join(', ')
---

<Page
  title="Повторение"
  noindex
  description="Интервальное повторение фраз курса «Испанский с нуля»: фразы из упражнений возвращаются через день, неделю и месяц."
>
  <header class="page-header">
    <p class="overline">Repaso</p>
    <h1>Повторение</h1>
    <p class="lead">
      Фразы, которые вы решали в упражнениях, возвращаются сюда по расписанию: через {intervals}.
      Ответили верно — следующий повтор позже, ошиблись — фраза вернётся завтра. Так выученное не
      забывается, а на повторение уходит несколько минут в день.
    </p>
  </header>

  <Review
    client:only="react"
    sentences={sentences}
    start={first ? lessonPath(first.id, 'practice') : '/lessons/'}
  />
  <noscript>
    <p class="card">Для повторения нужен включённый JavaScript.</p>
  </noscript>
</Page>

<style>
  .page-header {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    padding-bottom: 1.75rem;
  }
</style>

---
import { Picture } from 'astro:assets'
import { container } from '../app/container.ts'
import { LINKS } from '../app/links.ts'
import tim from '../assets/tim.png'
import { lessonPath } from '../features/lessons/navigation.ts'
import Page from '../app/Page.astro'

const [first] = await container.lessons.list()
const channel = container.videos.channel
---

<Page description="Испанский с нуля для русскоязычных: видеоуроки на YouTube, а здесь — конспекты, дополнительные материалы и упражнения к каждому уроку.">
  <section class="hero">
    <div class="head">
      <p class="overline">Испанский с нуля</p>
      <h1>Español con Tim</h1>
    </div>
    <Picture
      pictureAttributes={{ class: 'portrait' }}
      src={tim}
      alt="Тимур, автор курса"
      formats={['avif']}
      fallbackFormat="webp"
      quality={80}
      widths={[200, 320, 480, 672, 900]}
      sizes="(min-width: 40rem) 21rem, 40vw"
      loading="eager"
    />
    <div class="body">
      <p class="lead">
        Курс испанского для тех, кто начинает с нуля. Уроки выходят на YouTube, а здесь к каждому
        уроку — конспект, дополнительные материалы и упражнения.
      </p>
      <p class="actions">
        {first && (
          <a class="button" href={lessonPath(first.id)}>
            Начать с урока 1
          </a>
        )}
        <a class="button button--ghost" href="/lessons/">
          Все уроки
        </a>
      </p>
    </div>
  </section>

  <section class="method card" aria-labelledby="method">
    <h2 id="method">Как устроен курс</h2>
    <p>
      По методу Мишеля Томаса: вы переводите фразы с русского на испанский, а новые слова появляются
      только внутри предложений — никаких списков слов для зубрёжки.
    </p>
    <p>
      Смотрите урок, потом закрепляйте: конспект напомнит правила, упражнения помогут довести фразы
      до автоматизма.
    </p>
  </section>

  <section class="links" aria-labelledby="links">
    <h2 id="links">Где ещё курс</h2>
    <ul>
      <li>
        <a href={channel}>YouTube</a> — видеоуроки
      </li>
      <li>
        <a href={LINKS.boosty}>Boosty</a> — подписка «Практика»: допматериалы ко всем урокам
      </li>
      <li>
        <a href={LINKS.telegram}>Telegram</a> — новости и конспекты
      </li>
    </ul>
  </section>
</Page>

<style>
  /*
   * Шапка как на обложках: фото без фона справа стоит на тонкой линии.
   * На телефоне — рядом с заголовком, на широком экране — рядом со всем текстом.
   */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'head portrait'
      'body body';
    margin-bottom: 2.5rem;
  }

  .head {
    display: grid;
    grid-area: head;
    gap: 1rem;
    align-self: end;
    padding-block: 1rem 1.25rem;
  }

  /* Рядом с фото на телефоне: «Español / con Tim», а не «Español con / Tim». */
  .head h1 {
    text-wrap: balance;
  }

  .head,
  .portrait {
    border-bottom: 1px solid var(--line);
  }

  .portrait {
    grid-area: portrait;
    align-self: end;
    width: min(40vw, 11rem);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  .body {
    display: grid;
    grid-area: body;
    gap: 1.25rem;
    padding-top: 1.25rem;
  }

  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) min(21rem, 40%);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        '. portrait'
        'head portrait'
        'body portrait'
        '. portrait';
      column-gap: 2rem;
      border-bottom: 1px solid var(--line);
    }

    .head,
    .portrait {
      border-bottom: 0;
    }

    .head {
      padding-block: 2rem 0;
    }

    .portrait {
      width: 100%;
    }

    .body {
      padding-block: 1.25rem 2.5rem;
    }
  }

  .lead {
    max-width: 36rem;
    color: var(--text-2);
    font-size: 1.1875rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .method {
    display: grid;
    gap: 0.75rem;
  }

  .links {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .links ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .links a {
    font-weight: 750;
  }
</style>

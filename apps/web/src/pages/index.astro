---
import { LEVEL_LESSONS, LEVELS } from '@espanolcontim/content'
import { Picture } from 'astro:assets'
import { container } from '../app/container.ts'
import { LINKS, SUBSCRIBE_PATH } from '../app/links.ts'
import tim from '../assets/tim.png'
import { LEVEL_NAMES } from '../features/lessons/labels.ts'
import { isPractice, lessonPath } from '../features/lessons/navigation.ts'
import { REVIEW_PATH } from '../features/review/navigation.ts'
import Page from '../app/Page.astro'

const lessons = await container.lessons.list()
const [first] = lessons
const channel = container.videos.channel
/** План курса: уровни, сколько уроков в плане и сколько уже вышло (практики не в счёт). */
const plan = LEVELS.flatMap((level) => {
  const planned = LEVEL_LESSONS[level]
  const released = lessons.filter((lesson) => lesson.level === level && !isPractice(lesson)).length
  return planned ? [{ level, planned, released }] : []
})
---

<Page description="Испанский с нуля для русскоязычных: видеоуроки на YouTube, а здесь — конспекты, дополнительные материалы и упражнения к каждому уроку.">
  <section class="hero">
    <div class="head">
      <p class="overline">Испанский с нуля</p>
      <h1>Español con Tim</h1>
    </div>
    <Picture
      pictureAttributes={{ class: 'portrait' }}
      src={tim}
      alt="Тимур, автор курса"
      formats={['avif']}
      fallbackFormat="webp"
      quality={80}
      widths={[200, 320, 480, 672, 900]}
      sizes="(min-width: 40rem) 21rem, 40vw"
      loading="eager"
    />
    <div class="body">
      <p class="lead">
        Курс испанского для тех, кто начинает с нуля, и для тех, кто уже учил и хочет продолжить.
        Уроки выходят на YouTube, а здесь к каждому уроку — конспект, упражнения с автопроверкой и
        повторение.
      </p>
      <p class="actions">
        {first && (
          <a class="button" href={lessonPath(first.id)}>
            Начать с урока 1
          </a>
        )}
        <a class="button button--ghost" href="/lessons/">
          Все уроки
        </a>
      </p>
    </div>
  </section>

  <section class="block" aria-labelledby="audience">
    <h2 id="audience">Кому подойдёт</h2>
    <ul class="audience">
      <li class="card">
        <h3>Начинаете с нуля</h3>
        <p class="ru">
          Идите по порядку с первого урока: каждый следующий опирается на предыдущий. Знать заранее
          ничего не нужно.
        </p>
        {first && (
          <p>
            <a href={lessonPath(first.id)}>Начать с урока 1 →</a>
          </p>
        )}
      </li>
      <li class="card">
        <h3>Уже учили испанский</h3>
        <p class="ru">
          Начните с любого урока. Выжимка на странице урока за пару минут напомнит главное, а
          проверка после урока — она бесплатна — покажет, что стоит повторить.
        </p>
        <p>
          <a href="/lessons/">Выбрать урок →</a>
        </p>
      </li>
    </ul>
  </section>

  <section class="block" aria-labelledby="method">
    <h2 id="method">Как устроен курс</h2>
    <ul class="features">
      <li>
        <h3>Без зубрёжки</h3>
        <p class="ru">
          По методу Мишеля Томаса: новые слова появляются только внутри фраз. Никаких списков слов —
          вы сразу строите предложения сами.
        </p>
      </li>
      <li>
        <h3>Говорите с первого урока</h3>
        <p class="ru">
          Уже в первом уроке вы здороваетесь, знакомитесь и спрашиваете, откуда собеседник, —
          по-испански.
        </p>
      </li>
      <li>
        <h3>Грамматика по полочкам</h3>
        <p class="ru">
          Каждое правило — короткой формулой, например «<span lang="es">quiero</span> + инфинитив».
          А в конспекте — сводные таблицы: всё нужное перед глазами.
        </p>
      </li>
    </ul>
  </section>

  <section class="block" aria-labelledby="how">
    <h2 id="how">Как заниматься</h2>
    <ol class="steps">
      <li>
        <h3>Посмотрите урок</h3>
        <p class="ru">
          На <a href={channel}>YouTube</a>: в каждом видео — одна тема, объяснение и много фраз для
          перевода.
        </p>
      </li>
      <li>
        <h3>Прочитайте конспект</h3>
        <p class="ru">
          На странице урока — выжимка: главные фразы и правило. В конспекте — всё подробно, с
          таблицами и диалогами.
        </p>
      </li>
      <li>
        <h3>Переводите фразы</h3>
        <p class="ru">
          Сайт проверяет ответ сразу. Забыли знак над буквой — засчитаем как «почти верно» и
          подскажем где. Буквы <span lang="es">á, ñ</span> и знаки <span lang="es">¿ ¡</span> —
          кнопками, удобно с телефона.
        </p>
      </li>
      <li>
        <h3>Пройдите проверку</h3>
        <p class="ru">Десяток заданий по фразам урока, в конце — результат и разбор ошибок.</p>
      </li>
      <li>
        <h3>Повторяйте</h3>
        <p class="ru">
          Решённые фразы возвращаются в <a href={REVIEW_PATH}>повторение</a> через 1, 3, 7, 14 и 30
          дней — так они остаются в памяти. Сколько повторить сегодня, видно в шапке сайта.
        </p>
      </li>
    </ol>
    <p class="ru">Регистрация не нужна: прогресс хранится в вашем браузере.</p>
  </section>

  <section class="block plan-block" aria-labelledby="plan">
    <h2 id="plan">План курса</h2>
    <ul class="plan">
      {plan.map(({ level, planned, released }) => (
        <li>
          <span class="level">{level}</span>
          <span class="level-name">{LEVEL_NAMES[level]}</span>
          <span class="ru">
            {released === 0
              ? `${planned} уроков, скоро`
              : released < planned
                ? `вышло ${released} из ${planned}`
                : `${planned} уроков`}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block subscription card" aria-labelledby="subscription">
    <p class="overline">Подписка «Практика»</p>
    <h2 id="subscription">Ещё больше живого испанского</h2>
    <p>
      К каждому уроку — дополнительные материалы: выражения, которые слышишь в Испании на каждом
      шагу, мини-история с продолжением, пословицы, скороговорки и факты об Испании. Например:
      почему испанцы ужинают в десять вечера? И почему <span lang="es">la foto</span>, а не{' '}
      <span lang="es">el foto</span>?
    </p>
    <p class="actions">
      <a class="button" href={SUBSCRIBE_PATH}>
        Что в подписке
      </a>
      {first && (
        <a class="button button--ghost" href={lessonPath(first.id, 'extras')}>
          Допматериалы урока 1 — бесплатно
        </a>
      )}
    </p>
  </section>

  <section class="links" aria-labelledby="links">
    <h2 id="links">Где ещё курс</h2>
    <ul>
      <li>
        <a href={channel}>YouTube</a> — видеоуроки
      </li>
      <li>
        <a href={LINKS.boosty}>Boosty</a> — подписка «Практика»: допматериалы ко всем урокам
      </li>
      <li>
        <a href={LINKS.telegram}>Telegram</a> — новости и конспекты
      </li>
    </ul>
  </section>
</Page>

<style>
  /*
   * Шапка как на обложках: фото без фона справа стоит на тонкой линии.
   * На телефоне — рядом с заголовком, на широком экране — рядом со всем текстом.
   */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'head portrait'
      'body body';
    margin-bottom: 2.5rem;
  }

  .head {
    display: grid;
    grid-area: head;
    gap: 1rem;
    align-self: end;
    padding-block: 1rem 1.25rem;
  }

  /* Рядом с фото на телефоне: «Español / con Tim», а не «Español con / Tim». */
  .head h1 {
    text-wrap: balance;
  }

  .head,
  .portrait {
    border-bottom: 1px solid var(--line);
  }

  .portrait {
    grid-area: portrait;
    align-self: end;
    width: min(40vw, 11rem);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  .body {
    display: grid;
    grid-area: body;
    gap: 1.25rem;
    padding-top: 1.25rem;
  }

  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) min(21rem, 40%);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        '. portrait'
        'head portrait'
        'body portrait'
        '. portrait';
      column-gap: 2rem;
      border-bottom: 1px solid var(--line);
    }

    .head,
    .portrait {
      border-bottom: 0;
    }

    .head {
      padding-block: 2rem 0;
    }

    .portrait {
      width: 100%;
    }

    .body {
      padding-block: 1.25rem 2.5rem;
    }
  }

  .lead {
    max-width: 36rem;
    color: var(--text-2);
    font-size: 1.1875rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .block {
    display: grid;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  .audience {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.375rem;
  }

  .audience a {
    font-weight: 750;
    text-decoration: none;
  }

  .audience a:hover {
    text-decoration: underline;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding-top: 0.75rem;
    border-top: 2px solid var(--accent);
  }

  /* Шаги — номером слева, как в списке уроков. */
  .steps {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    color: var(--accent);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.2;
  }

  /*
   * План курса: ячейки раскладываются по ширине блока, а не экрана — меню слева
   * на широком экране отнимает место. Узко — строками («A0» слева), шире — по две,
   * совсем широко — четыре карточки. Иначе «подготовительный» не влезает.
   */
  .plan-block {
    container-type: inline-size;
  }

  .plan {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    grid-template-areas:
      'level name'
      'level count';
    gap: 0 0.5rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .plan .level {
    grid-area: level;
    color: var(--accent);
    font-size: 1.3125rem;
    font-weight: 800;
  }

  .plan .level-name {
    grid-area: name;
    font-weight: 700;
  }

  .plan .ru {
    grid-area: count;
    font-size: 0.875rem;
  }

  @container (min-width: 30rem) {
    .plan {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 56rem) {
    .plan {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .plan li {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'level' 'name' 'count';
    }
  }

  .subscription {
    border-color: var(--accent);
  }

  .subscription p {
    max-width: 40rem;
  }

  .links {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .links ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .links a {
    font-weight: 750;
  }
</style>

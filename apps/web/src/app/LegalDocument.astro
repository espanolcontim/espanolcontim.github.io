---
import { POLICY_DATE } from './legal.ts'
import Page from './Page.astro'

/** Страница-документ (политика, согласие): заголовок, дата редакции, текст. Не для поиска. */
interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<Page title={title} description={description} noindex>
  <header class="page-header">
    <p class="overline">Документы</p>
    <h1>{title}</h1>
    <p class="ru">Редакция от {POLICY_DATE}</p>
  </header>
  <article class="document">
    <slot />
  </article>
</Page>

<style>
  .page-header {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .document {
    display: grid;
    gap: 0.875rem;
    max-width: 44rem;
  }

  .document :global(h2) {
    margin-top: 1.25rem;
  }

  .document :global(h3) {
    margin-top: 0.5rem;
    font-size: 1rem;
  }

  .document :global(p),
  .document :global(ul),
  .document :global(ol) {
    margin: 0;
  }

  .document :global(li + li) {
    margin-top: 0.375rem;
  }
</style>

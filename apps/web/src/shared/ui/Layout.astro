---
import '@fontsource-variable/manrope/wght.css'
import '@fontsource/noto-sans/latin-400.css'
import '@fontsource/noto-sans/latin-ext-400.css'
import '@fontsource/noto-sans/greek-400.css'
import '../styles/theme.css'
import '../styles/global.css'

/**
 * Каркас страницы: шапка (ссылки — слот nav), слева меню (слот sidebar), справа контент.
 * На широком экране меню видно всегда и не уезжает при прокрутке,
 * на телефоне выезжает по кнопке «Уроки».
 */
interface Props {
  /** Заголовок страницы; к нему добавится «— Español con Tim». */
  title?: string | undefined
  description: string
  links: { youtube: string; boosty: string; telegram: string }
}

const { title, description, links } = Astro.props
const fullTitle = title ? `${title} — Español con Tim` : 'Español con Tim — испанский с нуля'
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">
      К содержанию
    </a>
    <header class="topbar">
      <div class="topbar-inner">
        <button
          class="menu-button"
          type="button"
          aria-controls="sidebar"
          aria-expanded="false"
          data-sidebar-toggle
        >
          <span aria-hidden="true">☰</span> Уроки
        </button>
        <a class="logo" href="/">
          Español con Tim
        </a>
        <nav class="topnav" aria-label="Ссылки курса">
          <slot name="nav" />
          <a href={links.youtube}>YouTube</a>
          <a href={links.boosty}>Boosty</a>
        </nav>
      </div>
    </header>

    <div class="shell">
      <aside id="sidebar" class="sidebar">
        <slot name="sidebar" />
      </aside>
      <div class="column">
        <main id="main">
          <slot />
        </main>
        <footer class="footer">
          <p>Español con Tim — испанский с нуля</p>
          <p class="footer-links">
            <a href={links.youtube}>YouTube</a>
            <a href={links.boosty}>Boosty</a>
            <a href={links.telegram}>Telegram</a>
          </p>
        </footer>
      </div>
    </div>
    <div class="backdrop" data-backdrop></div>
  </body>
</html>

<script>
  // Меню на телефоне: кнопка «Уроки», подложка и Esc закрывают.
  const sidebar = document.getElementById('sidebar')
  const backdrop = document.querySelector<HTMLElement>('[data-backdrop]')
  const button = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]')

  const setOpen = (open: boolean) => {
    sidebar?.toggleAttribute('data-open', open)
    backdrop?.toggleAttribute('data-open', open)
    button?.setAttribute('aria-expanded', String(open))
  }

  button?.addEventListener('click', () => setOpen(!sidebar?.hasAttribute('data-open')))
  backdrop?.addEventListener('click', () => setOpen(false))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && sidebar?.hasAttribute('data-open')) {
      setOpen(false)
      button?.focus()
    }
  })

  // Открытый урок — в поле зрения меню, даже если он далеко внизу списка.
  const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]')
  if (sidebar && current) sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 3
</script>

<style>
  .topbar {
    border-bottom: 1px solid var(--line);
  }

  .topbar-inner,
  .shell {
    max-width: calc(var(--sidebar) + 2.5rem + var(--content) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.25rem;
  }

  .logo {
    color: var(--text);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .topnav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .topnav a {
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .topnav a:hover {
    color: var(--accent);
  }

  /* На узком телефоне в шапке только ссылки из слота; YouTube и Boosty — в подвале. */
  @media (max-width: 27.99rem) {
    .topnav a {
      display: none;
    }
  }

  .menu-button {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
  }

  .sidebar {
    padding-block: 1rem 2rem;
  }

  main {
    padding-block: 1.5rem 3rem;
  }

  .footer {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-2);
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  /* Телефон и планшет: меню выезжает слева поверх страницы. */
  @media (max-width: 63.99rem) {
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 10;
      width: min(19rem, 86vw);
      padding-inline: 1.25rem;
      overflow-y: auto;
      border-right: 1px solid var(--line);
      background: var(--bg);
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 0.2s ease,
        visibility 0.2s;
    }

    .sidebar[data-open] {
      transform: none;
      visibility: visible;
    }

    .backdrop[data-open] {
      position: fixed;
      inset: 0;
      z-index: 9;
      background: var(--backdrop);
    }
  }

  /* Широкий экран: меню слева видно всегда и не уезжает при прокрутке. */
  @media (min-width: 64rem) {
    .shell {
      display: grid;
      grid-template-columns: var(--sidebar) minmax(0, 1fr);
      gap: 2.5rem;
    }

    .sidebar {
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
    }

    .column {
      max-width: var(--content);
    }

    .menu-button {
      display: none;
    }
  }

  .skip:focus {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0.5rem 1rem;
    clip-path: none;
    background: var(--accent);
    color: var(--on-accent);
    z-index: 11;
  }
</style>

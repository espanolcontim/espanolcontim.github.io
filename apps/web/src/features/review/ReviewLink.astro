---
import { REVIEW_PATH } from './navigation.ts'

/**
 * Ссылка «Повторение» со счётчиком фраз на сегодня: в шапке, а на телефоне — в меню (menu),
 * там крупнее. Счётчик — из прогресса в браузере.
 */
interface Props {
  menu?: boolean
}

const { menu = false } = Astro.props
---

<a class:list={['review-link', { menu }]} href={REVIEW_PATH}>
  Повторение
  <span class="count" data-review-due hidden>
    <span class="visually-hidden">, на сегодня: </span>
    <span data-review-due-count></span>
  </span>
</a>

<script>
  import { dueCards, localDay } from '@espanolcontim/content'
  import { progress } from '../../app/browser.ts'
  import { cardsOf } from './progress.ts'

  const update = () => {
    const due = dueCards(cardsOf(progress.load()), localDay(new Date())).length
    for (const badge of document.querySelectorAll<HTMLElement>('[data-review-due]')) {
      badge.hidden = due === 0
      const count = badge.querySelector('[data-review-due-count]')
      if (count) count.textContent = String(due)
    }
  }

  update()
  progress.subscribe(update)
</script>

<style>
  .review-link {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    min-height: 2.25rem;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .review-link:hover {
    color: var(--accent);
  }

  .menu {
    color: var(--text);
    font-size: 1rem;
  }

  .count {
    min-width: 1.25rem;
    padding: 0 0.3125rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.75rem;
    line-height: 1.25rem;
    text-align: center;
  }

  .count[hidden] {
    display: none;
  }
</style>

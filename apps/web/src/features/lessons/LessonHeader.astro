---
import type { LessonMeta } from '@espanolcontim/content'
import { lessonName, repeatsLabel, SECTIONS } from './labels.ts'
import LessonTabs from './LessonTabs.astro'
import { lessonPath, planLabel, videoLink, type LessonSection } from './navigation.ts'

/**
 * Шапка урока в стиле обложек: надзаголовок, «11/14», уровень, тема.
 * На странице подраздела вместо темы — название подраздела и ссылка на урок. Внизу — вкладки урока.
 * У практики вместо «11/14» — после какого урока она стоит, под темой — какие уроки повторяет.
 */
interface Props {
  meta: LessonMeta
  channel: string
  /** Подраздел. Без него — шапка самого урока. */
  section?: LessonSection | undefined
}

const { meta, channel, section } = Astro.props
const { repeats } = meta
const name = lessonName(meta)
---

<header class="lesson-header">
  <p class="overline">Испанский с нуля · {name.toLowerCase()}</p>
  <p class="pills">
    {repeats ? (
      <span class="pill pill--accent">после урока {repeats.to}</span>
    ) : (
      <span class="pill pill--accent">
        <span class="visually-hidden">Урок в уровне: </span>
        {planLabel(meta)}
      </span>
    )}
    <span class="pill">Уровень {meta.level}</span>
  </p>
  {section ? (
    <>
      <p class="back">
        <a href={lessonPath(meta.id)}>
          ← {name}. {meta.title}
        </a>
      </p>
      <h1>{SECTIONS[section].title}</h1>
    </>
  ) : (
    <>
      <h1>{meta.title}</h1>
      {repeats && (
        <p class="repeats">
          Повторяем {repeatsLabel(repeats)} — без новых слов и правил: только перевод фраз.
        </p>
      )}
      {meta.grammar.length > 0 && (
        <ul class="chips" aria-label="Грамматика урока">
          {meta.grammar.map((item) => (
            <li class="chip">{item}</li>
          ))}
        </ul>
      )}
      <p>
        <a class="button" href={videoLink(meta, channel)}>
          <span aria-hidden="true">▶</span> Смотреть {repeats ? 'практику' : 'урок'} на YouTube
        </a>
      </p>
    </>
  )}
  <LessonTabs meta={meta} current={section ?? 'overview'} />
</header>

<style>
  .lesson-header {
    display: grid;
    gap: 0.875rem;
    padding-bottom: 1.75rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .repeats {
    color: var(--text-2);
  }

  .back a {
    color: var(--text-2);
    font-weight: 700;
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }
</style>

---
import type { Extras } from '@espanolcontim/content'
import Ipa from '../../shared/ui/Ipa.astro'
import Marked from '../../shared/ui/Marked.astro'
import { CULTURE_KINDS } from './labels.ts'
import Dialogue from './notes/Dialogue.astro'

/**
 * Дополнительные материалы как текст: выражения, история, фразы, «Испания
 * изнутри», «Ваш ход». Упражнения из них — в подразделе «Упражнения».
 */
interface Props {
  extras: Extras
}

const { expressions, story, phrases, culture, yourTurn } = Astro.props.extras
---

<div class="extras">
  {expressions.length > 0 && (
    <section aria-labelledby="expressions">
      <h2 id="expressions">Живые выражения</h2>
      <ul class="list">
        {expressions.map((expression) => (
          <li class="card">
            <p>
              <Marked text={expression.es} lang="es" class="es big" /> <Ipa ipa={expression.ipa} />
            </p>
            <p class="ru">
              <Marked text={expression.ru} />
            </p>
            {expression.note && <p>{expression.note}</p>}
            {expression.example && (
              <p class="example">
                <Marked text={expression.example.es} lang="es" class="es" />
                <br />
                <Marked text={expression.example.ru} class="ru" />
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="story">
    <h2 id="story">История: {story.title}</h2>
    <Dialogue lines={story.lines} />
    {story.glossary && story.glossary.length > 0 && (
      <p class="glossary">
        <span class="ru">Новые слова: </span>
        {story.glossary.map((entry, i) => (
          <>
            {i > 0 && ', '}
            <span lang="es" class="es">
              {entry.es}
            </span>{' '}
            — {entry.ru}
          </>
        ))}
      </p>
    )}
    {story.questions.length > 0 && (
      <div>
        <h3>Вопросы к истории</h3>
        <ol class="questions">
          {story.questions.map((question) => (
            <li>
              <span lang="es">{question.question}</span>
              <details>
                <summary>Ответ</summary>
                <span lang="es">{question.answer}</span>
              </details>
            </li>
          ))}
        </ol>
      </div>
    )}
  </section>

  {phrases.length > 0 && (
    <section aria-labelledby="phrases">
      <h2 id="phrases">Фразы с характером</h2>
      <ul class="phrases">
        {phrases.map((phrase) => (
          <li>
            <Marked text={phrase.es} lang="es" class="es" /> <Ipa ipa={phrase.ipa} />
            <br />
            <Marked text={phrase.ru} class="ru" />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="culture" class="card culture">
    <p class="overline">Испания изнутри · {CULTURE_KINDS[culture.kind]}</p>
    <h2 id="culture">{culture.title}</h2>
    {culture.es && (
      <p>
        <span lang="es" class="es big">
          {culture.es}
        </span>{' '}
        <Ipa ipa={culture.ipa} />
        {culture.ru && (
          <>
            <br />
            <span class="ru">{culture.ru}</span>
          </>
        )}
      </p>
    )}
    <p>
      <Marked text={culture.text} />
    </p>
  </section>

  <section aria-labelledby="your-turn">
    <h2 id="your-turn">Ваш ход</h2>
    <p>{yourTurn.task}</p>
    {yourTurn.template && (
      <ul class="chips" aria-label="Начните так">
        {yourTurn.template.map((start) => (
          <li class="chip" lang="es">
            {start}
          </li>
        ))}
      </ul>
    )}
    <details>
      <summary>Образец</summary>
      <ul class="phrases">
        {yourTurn.model.map((phrase) => (
          <li>
            <Marked text={phrase.es} lang="es" class="es" />
            <br />
            <Marked text={phrase.ru} class="ru" />
          </li>
        ))}
      </ul>
    </details>
  </section>
</div>

<style>
  .extras,
  section {
    display: grid;
    gap: 1rem;
  }

  .extras {
    gap: 2rem;
  }

  .list,
  .phrases,
  .questions {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .questions {
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .list li {
    display: grid;
    gap: 0.375rem;
  }

  .phrases li {
    padding-left: 0.75rem;
    border-left: 2px solid var(--accent-soft);
  }

  .extras :global(.es) {
    font-weight: 700;
  }

  .extras :global(.big) {
    font-size: 1.0625rem;
  }

  .example {
    margin-top: 0.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .culture {
    gap: 0.625rem;
    border-left: 2px solid var(--accent);
  }

  summary {
    width: fit-content;
    color: var(--accent);
    font-weight: 700;
    cursor: pointer;
  }

  details[open] summary {
    margin-bottom: 0.5rem;
  }
</style>

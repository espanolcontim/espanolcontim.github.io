---
import type { Sentence, Summary } from '@espanolcontim/content'
import Ipa from '../../shared/ui/Ipa.astro'
import Marked from '../../shared/ui/Marked.astro'
import SentenceTask from './SentenceTask.astro'

/** Выжимка урока: ключевые фразы, главное правило, типичная ошибка, мини-практика. */
interface Props {
  summary: Summary
  sentences: Sentence[]
}

const { summary, sentences } = Astro.props
const byId = new Map(sentences.map((sentence) => [sentence.id, sentence]))
const practice = summary.practice.flatMap((id) => byId.get(id) ?? [])
const { wrong, right } = summary.mistake
---

<section class="summary" aria-labelledby="summary">
  <h2 id="summary">Коротко об уроке</h2>

  <ul class="phrases">
    {summary.phrases.map((phrase) => (
      <li>
        <Marked text={phrase.es} lang="es" class="es" /> <Ipa ipa={phrase.ipa} />
        <br />
        <Marked text={phrase.ru} class="ru" />
      </li>
    ))}
  </ul>

  <div class="card rule">
    <h3>Главное правило</h3>
    <p>
      <Marked text={summary.rule} />
    </p>
  </div>

  <div class="mistake">
    <div class="side wrong">
      <p class="label">
        <span aria-hidden="true">✗ </span>
        {wrong.label ?? 'так не говорят'}
      </p>
      <Marked text={wrong.es} lang="es" class="es" />
      {wrong.ru && (
        <p class="ru">
          <Marked text={wrong.ru} />
        </p>
      )}
    </div>
    <div class="side right">
      <p class="label">
        <span aria-hidden="true">✓ </span>
        {right.label ?? 'так говорят'}
      </p>
      <Marked text={right.es} lang="es" class="es" />
      {right.ru && (
        <p class="ru">
          <Marked text={right.ru} />
        </p>
      )}
    </div>
  </div>

  {practice.length > 0 && (
    <div>
      <h3>Переведите сами</h3>
      <ol class="tasks">
        {practice.map((sentence) => (
          <li>
            <SentenceTask sentence={sentence} />
          </li>
        ))}
      </ol>
    </div>
  )}
</section>

<style>
  .summary {
    display: grid;
    gap: 1.25rem;
  }

  .phrases {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .phrases li {
    padding-left: 0.75rem;
    border-left: 2px solid var(--accent-soft);
  }

  .phrases :global(.es) {
    font-weight: 700;
  }

  .rule {
    display: grid;
    gap: 0.5rem;
  }

  .mistake {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .side {
    padding: 0.25rem 0 0.25rem 0.875rem;
    border-left: 2px solid var(--line);
  }

  .wrong {
    border-left-color: var(--bad);
  }

  .right {
    border-left-color: var(--ok);
  }

  .label {
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .wrong .label {
    color: var(--bad);
  }

  .right .label {
    color: var(--ok);
  }

  .side :global(.es) {
    font-weight: 700;
  }

  .wrong :global(.es) {
    text-decoration: line-through;
    text-decoration-color: var(--bad);
  }

  .tasks {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding-left: 1.5rem;
  }
</style>

---
import { LINKS } from '../../app/links.ts'
import { LOCKED_HINT, SUBSCRIPTION } from './labels.ts'

/** Закрытая часть урока: что внутри и где взять. */
interface Props {
  /** Что внутри: «теория, таблицы, диалоги и новые слова». */
  inside: string
}

const { inside } = Astro.props
---

<div class="locked card">
  <p class="pill pill--lock">{SUBSCRIPTION}</p>
  <p>Внутри — {inside}.</p>
  <p class="ru">{LOCKED_HINT}</p>
  <p>
    <a class="button" href={LINKS.boosty}>
      Подписка на Boosty
    </a>
  </p>
</div>

<style>
  .locked {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
</style>

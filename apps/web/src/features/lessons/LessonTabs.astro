---
import type { LessonMeta } from '@espanolcontim/content'
import { sectionLocked, SUBSCRIPTION, tabTitle } from './labels.ts'
import { lessonPath, lessonSections, type LessonPage } from './navigation.ts'
import PaidNote from './PaidNote.astro'

/**
 * Вкладки урока: обзор и подразделы — с любой страницы урока в любую. У закрытых
 * целиком — замок. На узком экране не влезают и листаются вбок; открытая — в поле зрения.
 */
interface Props {
  meta: LessonMeta
  current: LessonPage
}

const { meta, current } = Astro.props
const pages: LessonPage[] = ['overview', ...lessonSections(meta)]
---

<nav class="lesson-tabs" aria-label="Разделы урока" data-lesson-tabs>
  <ul>
    {pages.map((page) => (
      <li>
        <a href={lessonPath(meta.id, page)} aria-current={page === current ? 'page' : undefined}>
          {tabTitle(page)}
          {page !== 'overview' && sectionLocked(meta, page) && (
            <PaidNote note={SUBSCRIPTION} icon />
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Только вбок: scrollIntoView прокрутил бы и страницу, если её открыли не с начала.
  for (const list of document.querySelectorAll('[data-lesson-tabs] ul')) {
    const current = list.querySelector('[aria-current]')
    if (!current) continue
    const overflow = current.getBoundingClientRect().right - list.getBoundingClientRect().right
    if (overflow > 0) list.scrollLeft += overflow + 16
  }
</script>

<style>
  /* Шапка урока — grid: без этого строка вкладок раздвинет страницу, а не прокрутится. */
  .lesson-tabs {
    min-width: 0;
  }

  .lesson-tabs ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    list-style: none;
    scrollbar-width: none;
  }

  .lesson-tabs li {
    flex: none;
  }

  .lesson-tabs a {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    min-height: 2.5rem;
    border-bottom: 2px solid transparent;
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .lesson-tabs a:hover {
    color: var(--accent);
  }

  /* Список прокручивается и обрезает всё, что снаружи, — рамка фокуса внутри. */
  .lesson-tabs a:focus-visible {
    outline-offset: -2px;
  }

  .lesson-tabs a[aria-current='page'] {
    border-bottom-color: var(--accent);
    color: var(--text);
  }
</style>

---
import type { NoteBlock } from '@espanolcontim/content'
import Ipa from '../../../shared/ui/Ipa.astro'

/** Спряжение: местоимение, основа + окончание (выделено), транскрипция, перевод. */
type Props = Extract<NoteBlock, { type: 'conjugation' }>

const { verb, ru, rows } = Astro.props
---

<div class="conjugation">
  <h3>
    <span lang="es">{verb}</span> — {ru}
  </h3>
  <ul>
    {rows.map((row) => (
      <li>
        <span class="pronoun" lang="es">
          {row.pronoun}
        </span>
        <span>
          <span class="form" lang="es">
            {row.stem}
            <strong class="ending">{row.ending}</strong>
          </span>{' '}
          <Ipa ipa={row.ipa} />
          <br />
          <span class="ru">{row.ru}</span>
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.4fr) 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .pronoun {
    color: var(--text-2);
  }

  .form {
    font-weight: 700;
  }

  .ending {
    color: var(--accent);
    font-weight: 800;
  }
</style>

---
import type { NoteBlock } from '@espanolcontim/content'
import Ipa from '../../../shared/ui/Ipa.astro'
import Marked from '../../../shared/ui/Marked.astro'

/**
 * Сравнение в две колонки: ser / estar, «так не говорят / так говорят».
 * Пункты идут парами: левый напротив правого.
 */
type Props = Extract<NoteBlock, { type: 'compare' }>

const { title, left, right } = Astro.props
const sides = [left, right]
const mark = { wrong: '✗', right: '✓' } as const
---

<div class="compare">
  <h3>{title}</h3>
  <div class="sides">
    {sides.map((side) => (
      <div class:list={['side', side.tone]}>
        <p class="label">
          {side.tone && <span aria-hidden="true">{mark[side.tone]} </span>}
          {side.label}
        </p>
        <ul>
          {side.items.map((item) => (
            <li>
              <Marked text={item.es} lang="es" class="es" />
              {item.ipa && (
                <>
                  {' '}
                  <Ipa ipa={item.ipa} />
                </>
              )}
              {item.ru && (
                <>
                  <br />
                  <Marked text={item.ru} class="ru" />
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  .sides {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .side {
    padding: 0.25rem 0 0.25rem 0.875rem;
    border-left: 2px solid var(--line);
  }

  .side.wrong {
    border-left-color: var(--bad);
  }

  .side.right {
    border-left-color: var(--ok);
  }

  .label {
    margin-bottom: 0.375rem;
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .wrong .label {
    color: var(--bad);
  }

  .right .label {
    color: var(--ok);
  }

  ul {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side :global(.es) {
    font-weight: 700;
  }

  .wrong :global(.es) {
    text-decoration: line-through;
    text-decoration-color: var(--bad);
  }

  @media (max-width: 22rem) {
    .sides {
      grid-template-columns: 1fr;
    }
  }
</style>

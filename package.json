{
  "name": "espanolcontim",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions/*",
    "scripts"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev -w @espanolcontim/web",
    "build": "npm run build -w @espanolcontim/web",
    "preview": "npm run preview -w @espanolcontim/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/content && tsc -p functions/shared && tsc -p functions/sync && tsc -p functions/api && tsc -p scripts && npm run check -w @espanolcontim/web",
    "content:import": "node scripts/content-import.ts",
    "functions:build": "node scripts/functions-build.ts",
    "sync:local": "node functions/sync/src/local.ts",
    "api:local": "node functions/api/src/local.ts"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

    "dialogues": [
      {
        "title": "Где ты живёшь?",
        "lines": [
          {
            "es": "¿**Vives** en Moscú?",
            "ru": "Ты живёшь в Москве?",
            "speaker": "Carlos"
          },
          {
            "es": "No, **vivo** en Madrid. ¿Y tú?",
            "ru": "Нет, я живу в Мадриде. А ты?",
            "speaker": "Ana"
          },
          {
            "es": "Yo **vivo** en Moscú, en el centro.",
            "ru": "Я живу в Москве, в центре.",
            "speaker": "Carlos"
          },
          {
            "es": "¿**Comprendes** español?",
            "ru": "Ты понимаешь по-испански?",
            "speaker": "Ana"
          },
          {
            "es": "Sí, pero **leo** poco.",
            "ru": "Да, но читаю мало.",
            "speaker": "Carlos"
          },
          {
            "es": "Yo **leo** mucho. Leo el periódico.",
            "ru": "Я читаю много. Читаю газету.",
            "speaker": "Ana"
          },
          {
            "es": "¿Y **escribes** en español?",
            "ru": "А по-испански пишешь?",
            "speaker": "Carlos"
          },
          {
            "es": "Sí, **escribo** un libro.",
            "ru": "Да, я пишу книгу.",
            "speaker": "Ana"
          }
        ]
      }
    ],

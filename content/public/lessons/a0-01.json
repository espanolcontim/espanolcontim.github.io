  "extras": {
    "expressions": [
      {
        "es": "¿Qué tal?",
        "ru": "Как дела? Как ты?",
        "ipa": "ke ˈtal",
        "note": "Самый частый вопрос после hola. Часто говорят одним духом: ¡Hola, qué tal!",
        "example": {
          "es": "¡Hola, Carlos! ¿Qué tal?",
          "ru": "Привет, Карлос! Как дела?"
        }
      },
      {
        "es": "¡Buenas!",
        "ru": "Здравствуйте! Привет!",
        "ipa": "ˈbwenas",
        "note": "Короткое buenas tardes или buenas noches, годится в любое время дня. Так здороваются в магазине, в баре, с соседями.",
        "example": {
          "es": "¡Buenas! ¿Qué tal?",
          "ru": "Здрасьте! Как дела?"
        }
      },
      {
        "es": "Encantado. / Encantada.",
        "ru": "Очень приятно.",
        "ipa": "enkanˈtado / enkanˈtada",
        "note": "Говорят при знакомстве. Мужчина — encantado, женщина — encantada: окончание зависит от того, кто говорит.",
        "example": {
          "es": "Me llamo Ana. — Encantado. Me llamo Carlos.",
          "ru": "Меня зовут Ана. — Очень приятно. Меня зовут Карлос."
        }
      },
      {
        "es": "¡Hasta mañana!",
        "ru": "До завтра!",
        "ipa": "ˈasta maˈɲana",
        "note": "Устроено как hasta luego: hasta, а потом — когда увидимся. Mañana — «завтра», подробно — в уроке 4.",
        "example": {
          "es": "Gracias, José. ¡Hasta mañana!",
          "ru": "Спасибо, Хосе. До завтра!"
        }
      }
    ],

          {
            "type": "rule",
            "title": "Мне нравится + инфинитив",
            "pattern": [
              "me / te gusta",
              "+",
              "инфинитив"
            ],
            "text": "gusta не меняется, даже если действий два.",
            "examples": [
              {
                "es": "Me gusta **bailar**.",
                "ru": "Мне нравится танцевать.",
                "ipa": "me ˈgusta bajˈlaɾ"

      {
        "id": "section-2",
        "title": "Очень: muy и mucho",
        "hint": "muy — перед «как?», mucho — после глагола",
        "blocks": [
          {
            "type": "rule",
            "title": "Muy + как?",
            "pattern": [
              "muy",
              "+",
              "как?"
            ],
            "text": "muy — «очень» перед словом, которое отвечает на вопрос «как?».",
            "examples": [
              {
                "es": "Cocinas **muy** bien.",
                "ru": "Ты очень хорошо готовишь.",
                "ipa": "koˈθinas ˈmuj ˈbjen"

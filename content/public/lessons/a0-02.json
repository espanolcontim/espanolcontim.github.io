{
  "id": "a0-02",
  "summary": {
    "phrases": [
      {
        "es": "Hablo español.",
        "ru": "Я говорю по-испански.",
        "ipa": "ˈablo espaˈɲol"
      },
      {
        "es": "Estudio inglés.",
        "ru": "Я учу английский.",
        "ipa": "esˈtudjo inˈgles"
      },
      {
        "es": "Trabajo mucho.",
        "ru": "Я много работаю.",
        "ipa": "tɾaˈbaxo ˈmutʃo"
      },
      {
        "es": "¿Hablas español?",
        "ru": "Ты говоришь по-испански?",
        "ipa": "ˈablas espaˈɲol"
      },
      {
        "es": "No hablo inglés.",
        "ru": "Я не говорю по-английски.",
        "ipa": "no ˈablo inˈgles"
      },
      {
        "es": "Sí, estudio español.",
        "ru": "Да, я учу испанский.",
        "ipa": "ˈsi esˈtudjo espaˈɲol"
      },
      {
        "es": "Trabajo y estudio.",
        "ru": "Я работаю и учусь.",
        "ipa": "tɾaˈbaxo i esˈtudjo"
      },
      {
        "es": "Estudio mucho, pero hablo poco.",
        "ru": "Я много учусь, но говорю мало.",
        "ipa": "esˈtudjo ˈmutʃo ˈpeɾo ˈablo ˈpoko"
      },
      {
        "es": "Hablo español e inglés.",
        "ru": "Я говорю по-испански и по-английски.",
        "ipa": "ˈablo espaˈɲol e inˈgles"
      }
    ],
    "rule": "Глагол на **-ar**: убираем -ar и добавляем **-o** (я) или **-as** (ты): habl**o**, habl**as**. Yo и tú обычно не нужны. Отрицание — **no** перед глаголом, вопрос — интонацией: ¿Hablas español?",
    "mistake": {
      "wrong": {
        "es": "Hablo español y inglés."
      },
      "right": {
        "es": "Hablo español e inglés.",
        "ru": "перед звуком [i] вместо y — e"
      }
    },
    "practice": [
      "a0-02-s21",
      "a0-02-s24",
      "a0-02-s26",
      "a0-02-s27"
    ]
  },
  "notes": {
    "sections": [
      {
        "id": "section-1",
        "title": "Форма «я»",
        "hint": "Убираем -ar и добавляем -o",
        "blocks": [
          {
            "type": "rule",
            "title": "Форма «я»",
            "pattern": [
              "основа",
              "+",
              "-o"
            ],
            "text": "Убираем -ar и добавляем -o: hablar → hablo.",
            "examples": [
              {
                "es": "hablar — **Hablo** inglés.",
                "ru": "Я говорю по-английски.",
                "ipa": "aˈblaɾ · ˈablo inˈgles"
              },
              {
                "es": "estudiar — **Estudio** mucho.",
                "ru": "Я много учусь.",
                "ipa": "estuˈdjaɾ · esˈtudjo ˈmutʃo"
              },
              {
                "es": "trabajar — **Trabajo**.",
                "ru": "Я работаю.",
                "ipa": "tɾabaˈxaɾ · tɾaˈbaxo"
              }
            ]
          },
          {
            "type": "words",
            "title": "Первые глаголы",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "**Hablo** **español**.",
                "ru": "Я говорю по-испански.",
                "ipa": "ˈablo espaˈɲol"
              },
              {
                "es": "**Trabajo** **mucho**.",
                "ru": "Я много работаю.",
                "ipa": "tɾaˈbaxo ˈmutʃo"
              },
              {
                "es": "**Estudio** **inglés**.",
                "ru": "Я учу английский.",
                "ipa": "esˈtudjo inˈgles"
              }
            ]
          }
        ]
      },
      {
        "id": "section-2",
        "title": "Форма «ты»",
        "hint": "Убираем -ar и добавляем -as",
        "blocks": [
          {
            "type": "rule",
            "title": "Форма «ты»",
            "pattern": [
              "основа",
              "+",
              "-as"
            ],
            "text": "Убираем -ar и добавляем -as: hablar → hablas.",
            "examples": [
              {
                "es": "**Hablas** inglés.",
                "ru": "Ты говоришь по-английски.",
                "ipa": "ˈablas inˈgles"
              },
              {
                "es": "**Estudias** español.",
                "ru": "Ты учишь испанский.",
                "ipa": "esˈtudjas espaˈɲol"
              },
              {
                "es": "**Trabajas**.",
                "ru": "Ты работаешь.",
                "ipa": "tɾaˈbaxas"
              }
            ]
          },
          {
            "type": "words",
            "title": "Форма «ты»",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "**Hablas** español.",
                "ru": "Ты говоришь по-испански.",
                "ipa": "ˈablas espaˈɲol"
              },
              {
                "es": "**Estudias** mucho.",
                "ru": "Ты много учишься.",
                "ipa": "esˈtudjas ˈmutʃo"
              },
              {
                "es": "**Trabajas** **poco**.",
                "ru": "Ты мало работаешь.",
                "ipa": "tɾaˈbaxas ˈpoko"
              }
            ]
          },
          {
            "type": "conjugation",
            "verb": "hablar",
            "ru": "говорить",
            "rows": [
              {
                "stem": "habl",
                "ending": "o",
                "ipa": "ˈablo",
                "pronoun": "yo",
                "ru": "я говорю"
              },
              {
                "stem": "habl",
                "ending": "as",
                "ipa": "ˈablas",
                "pronoun": "tú",
                "ru": "ты говоришь"
              }
            ]
          },
          {
            "type": "words",
            "title": "Я и ты",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "**Yo** hablo mucho, **tú** hablas poco.",
                "ru": "Я говорю много, а ты — мало.",
                "ipa": "ˈjo ˈablo ˈmutʃo ˈtu ˈablas ˈpoko"
              },
              {
                "es": "**Tú** estudias inglés, yo estudio español.",
                "ru": "Ты учишь английский, а я — испанский.",
                "ipa": "ˈtu esˈtudjas inˈgles ˈjo esˈtudjo espaˈɲol"
              }
            ]
          },
          {
            "type": "compare",
            "title": "Когда нужны yo и tú",
            "left": {
              "label": "обычно",
              "items": [
                {
                  "es": "Hablo mucho.",
                  "ru": "Я много говорю."
                },
                {
                  "es": "Estudias inglés.",
                  "ru": "Ты учишь английский."
                }
              ]
            },
            "right": {
              "label": "когда противопоставляем",
              "items": [
                {
                  "es": "**Yo** hablo mucho.",
                  "ru": "А вот я много говорю."
                },
                {
                  "es": "**Tú** estudias inglés.",
                  "ru": "А вот ты учишь английский."
                }
              ]
            }
          }
        ]
      },
      {
        "id": "section-3",
        "title": "Нет и вопрос",
        "hint": "No перед глаголом, вопрос — интонацией",
        "blocks": [
          {
            "type": "rule",
            "title": "Отрицание",
            "pattern": [
              "no",
              "+",
              "глагол"
            ],
            "text": "No ставим прямо перед глаголом, как русское «не».",
            "examples": [
              {
                "es": "**No** trabajo.",
                "ru": "Я не работаю.",
                "ipa": "no tɾaˈbaxo"
              },
              {
                "es": "**No** hablas mucho.",
                "ru": "Ты говоришь немного.",
                "ipa": "no ˈablas ˈmutʃo"
              },
              {
                "es": "**No**, **no** estudio.",
                "ru": "Нет, я не учусь.",
                "ipa": "ˈno no esˈtudjo"
              }
            ]
          },
          {
            "type": "words",
            "title": "Да и нет",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "**No** hablo inglés.",
                "ru": "Я не говорю по-английски.",
                "ipa": "no ˈablo inˈgles"
              },
              {
                "es": "Tú **no** estudias.",
                "ru": "Ты не учишься.",
                "ipa": "ˈtu no esˈtudjas"
              },
              {
                "es": "**Sí**, estudio español.",
                "ru": "Да, я учу испанский.",
                "ipa": "ˈsi esˈtudjo espaˈɲol"
              }
            ]
          },
          {
            "type": "rule",
            "title": "Вопрос",
            "pattern": [
              "¿",
              "фраза",
              "?"
            ],
            "text": "Порядок слов тот же. Вопрос слышно по интонации.",
            "examples": [
              {
                "es": "¿Hablas español?",
                "ru": "Ты говоришь по-испански?",
                "ipa": "ˈablas espaˈɲol"
              },
              {
                "es": "¿Trabajas mucho?",
                "ru": "Ты много работаешь?",
                "ipa": "tɾaˈbaxas ˈmutʃo"
              },
              {
                "es": "¿No estudias?",
                "ru": "Ты не учишься?",
                "ipa": "no esˈtudjas"
              }
            ]
          }
        ]
      },
      {
        "id": "section-4",
        "title": "Языки",
        "hint": "hablar + язык — без артикля",
        "blocks": [
          {
            "type": "words",
            "title": "Языки",
            "headers": {

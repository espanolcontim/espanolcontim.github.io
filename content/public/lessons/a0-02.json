                "ipa": "esˈtudjas aleˈman"
              },
              {
                "es": "enseñar — **Enseño** **chino**.",
                "ru": "Я преподаю китайский.",
                "ipa": "enseˈɲaɾ · enˈseɲo ˈtʃino"
              }
            ]
          }
        ]
      },
      {
        "id": "section-5",
        "title": "И, но",
        "hint": "y — «и», перед i- — e; pero — «но»",
        "blocks": [
          {
            "type": "words",
            "title": "И и но",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "Trabajo **y** estudio.",
                "ru": "Я работаю и учусь.",
                "ipa": "tɾaˈbaxo i esˈtudjo"
              },
              {
                "es": "Hablo ruso **y** francés.",
                "ru": "Я говорю по-русски и по-французски.",
                "ipa": "ˈablo ˈruso i fɾanˈθes"
              },
              {
                "es": "Estudio mucho, **pero** hablo poco.",
                "ru": "Я много учусь, но говорю мало.",
                "ipa": "esˈtudjo ˈmutʃo ˈpeɾo ˈablo ˈpoko"
              },
              {
                "es": "Hablo español **e** inglés.",
                "ru": "Я говорю по-испански и по-английски.",
                "ipa": "ˈablo espaˈɲol e inˈgles"
              }
            ]
          },
          {
            "type": "rule",
            "title": "y превращается в e",
            "pattern": [
              "y",
              "→",
              "e перед i-, hi-"
            ],
            "text": "Перед словом на звук [i] вместо y говорим e.",
            "examples": [
              {
                "es": "Hablo español **e** inglés.",
                "ru": "Я говорю по-испански и по-английски.",
                "ipa": "ˈablo espaˈɲol e inˈgles"
              },
              {
                "es": "Estudio alemán **e** inglés.",
                "ru": "Я учу немецкий и английский.",
                "ipa": "esˈtudjo aleˈman e inˈgles"
              },
              {
                "es": "Hablo ruso **y** español.",
                "ru": "Я говорю по-русски и по-испански.",
                "ipa": "ˈablo ˈruso i espaˈɲol"
              }
            ]
          },
          {
            "type": "compare",
            "title": "Типичная ошибка",
            "left": {
              "label": "так не говорят",
              "tone": "wrong",
              "items": [

            "right": {
              "label": "так говорят",
              "tone": "right",
              "items": [
                {
                  "es": "Hablo español **e** inglés.",
                  "ru": "Я говорю по-испански и по-английски."
                },
                {
                  "es": "Estudio francés **e** inglés.",
                  "ru": "Я учу французский и английский."

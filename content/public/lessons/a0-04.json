{
  "id": "a0-04",
  "summary": {
    "phrases": [
      {
        "es": "Voy a estudiar español.",
        "ru": "Я собираюсь учить испанский.",
        "ipa": "ˈboj a estuˈdjaɾ espaˈɲol"
      },
      {
        "es": "No voy a dormir.",
        "ru": "Я не буду спать.",
        "ipa": "no ˈboj a doɾˈmiɾ"
      },
      {
        "es": "Mañana voy a trabajar.",
        "ru": "Завтра я буду работать.",
        "ipa": "maˈɲana ˈboj a tɾabaˈxaɾ"
      },
      {
        "es": "¿Vas a pasear o descansar?",
        "ru": "Ты пойдёшь гулять или будешь отдыхать?",
        "ipa": "ˈbas a paseˈaɾ o deskanˈsaɾ"
      },
      {
        "es": "Tengo que trabajar.",
        "ru": "Мне нужно работать.",
        "ipa": "ˈtengo ke tɾabaˈxaɾ"
      },
      {
        "es": "¿Tienes que cocinar hoy?",
        "ru": "Тебе сегодня нужно готовить?",
        "ipa": "ˈtjenes ke koθiˈnaɾ ˈoj"
      },
      {
        "es": "Mañana no tengo que trabajar.",
        "ru": "Завтра мне не нужно работать.",
        "ipa": "maˈɲana no ˈtengo ke tɾabaˈxaɾ"
      }
    ],
    "rule": "**Voy a** / **vas a** + инфинитив — план: я буду, я собираюсь. **Tengo que** / **tienes que** + инфинитив — обязанность: я должен. **No tienes que** — «не нужно», а не «нельзя».",
    "mistake": {
      "wrong": {
        "es": "Voy viajar."
      },
      "right": {
        "es": "Voy a viajar.",
        "ru": "между voy и глаголом — a"
      }
    },
    "practice": [
      "a0-04-s21",
      "a0-04-s24",
      "a0-04-s25",
      "a0-04-s30",
      "a0-04-s29"
    ]
  },
  "notes": {
    "sections": [
      {
        "id": "section-1",
        "title": "Я собираюсь",
        "hint": "voy a + глагол в начальной форме",
        "blocks": [
          {
            "type": "words",
            "title": "Я собираюсь, ты собираешься",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "**Voy a** trabajar.",
                "ru": "Я буду работать.",
                "ipa": "ˈboj a tɾabaˈxaɾ"
              },
              {
                "es": "**Voy a** estudiar español.",
                "ru": "Я собираюсь учить испанский.",
                "ipa": "ˈboj a estuˈdjaɾ espaˈɲol"
              },
              {
                "es": "¿**Vas a** cocinar?",
                "ru": "Ты будешь готовить?",
                "ipa": "ˈbas a koθiˈnaɾ"
              },
              {
                "es": "No **voy a** dormir.",
                "ru": "Я не буду спать.",
                "ipa": "no ˈboj a doɾˈmiɾ"
              }
            ]
          },
          {
            "type": "rule",
            "title": "Voy a + инфинитив",
            "pattern": [
              "voy a / vas a",
              "+",
              "инфинитив"
            ],
            "text": "Меняется только voy / vas. Второй глагол — в начальной форме.",
            "examples": [
              {
                "es": "**Voy a** leer.",
                "ru": "Я буду читать.",
                "ipa": "ˈboj a leˈeɾ"
              },
              {
                "es": "¿**Vas a** viajar?",
                "ru": "Ты будешь путешествовать?",
                "ipa": "ˈbas a bjaˈxaɾ"
              },
              {
                "es": "**Voy a** aprender inglés.",
                "ru": "Я собираюсь выучить английский.",
                "ipa": "ˈboj a apɾenˈdeɾ inˈgles"
              }
            ]
          },
          {
            "type": "words",
            "title": "Когда?",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
            },
            "rows": [
              {
                "es": "**Mañana** voy a trabajar.",

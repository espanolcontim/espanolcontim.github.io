    "dialogues": [
      {
        "title": "Hoy no puedo",
        "lines": [
          {
            "es": "Hola, Ana. ¿**Quieres comer**?",
            "ru": "Привет, Ана. Хочешь поесть?",
            "speaker": "Carlos"
          },
          {
            "es": "Ahora no **puedo**. **Necesito estudiar**.",
            "ru": "Сейчас не могу. Мне нужно учиться.",
            "speaker": "Ana"
          },
          {
            "es": "¿Estudias español?",
            "ru": "Ты учишь испанский?",
            "speaker": "Carlos"
          },
          {
            "es": "Sí, pero hablo poco. **Necesito practicar más**.",
            "ru": "Да, но говорю мало. Мне нужно больше практиковаться.",
            "speaker": "Ana"
          },
          {
            "es": "Yo **quiero aprender** ruso. ¿Puedes enseñar?",
            "ru": "Я хочу выучить русский. Можешь научить?",
            "speaker": "Carlos"
          },
          {
            "es": "Sí, pero **hoy** no **puedo**. **Quiero descansar**.",
            "ru": "Да, но сегодня не могу. Я хочу отдохнуть.",
            "speaker": "Ana"
          },
          {
            "es": "¿**Quieres comer ahora**?",
            "ru": "Хочешь поесть сейчас?",
            "speaker": "Carlos"
          },
          {
            "es": "¡Sí! **Quiero comer** y **descansar**.",
            "ru": "Да! Хочу поесть и отдохнуть.",
            "speaker": "Ana"
          }
        ]
      }

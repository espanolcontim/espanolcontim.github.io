{
  "id": "a0-03",
  "summary": {
    "phrases": [
      {
        "es": "Quiero hablar español.",
        "ru": "Я хочу говорить по-испански.",
        "ipa": "ˈkjeɾo aˈblaɾ espaˈɲol"
      },
      {
        "es": "Quiero comer.",
        "ru": "Я хочу есть.",
        "ipa": "ˈkjeɾo koˈmeɾ"
      },
      {
        "es": "Quiero dormir.",
        "ru": "Я хочу спать.",
        "ipa": "ˈkjeɾo doɾˈmiɾ"
      },
      {
        "es": "Puedo nadar.",
        "ru": "Я могу плавать.",
        "ipa": "ˈpwedo naˈdaɾ"
      },
      {
        "es": "¿Puedes bailar?",
        "ru": "Ты можешь танцевать?",
        "ipa": "ˈpwedes bajˈlaɾ"
      },
      {
        "es": "No puedo hablar ahora.",
        "ru": "Я не могу говорить сейчас.",
        "ipa": "no ˈpwedo aˈblaɾ aˈoɾa"
      },
      {
        "es": "Necesito descansar.",
        "ru": "Мне нужно отдохнуть.",
        "ipa": "neθeˈsito deskanˈsaɾ"
      },
      {
        "es": "Necesito aprender español.",
        "ru": "Мне нужно выучить испанский.",
        "ipa": "neθeˈsito apɾenˈdeɾ espaˈɲol"
      },
      {
        "es": "Quiero trabajar hoy.",
        "ru": "Я хочу работать сегодня.",
        "ipa": "ˈkjeɾo tɾabaˈxaɾ ˈoj"
      }
    ],
    "rule": "Лицо показывает только первый глагол: **quiero**, **puedo**, **necesito** (я) / **quieres**, **puedes**, **necesitas** (ты). Второй стоит в инфинитиве на **-ar**, **-er**, **-ir**: Quiero **hablar** español.",
    "mistake": {
      "wrong": {
        "es": "Quiero hablo español."
      },
      "right": {
        "es": "Quiero hablar español.",
        "ru": "второй глагол — в инфинитиве"
      }
    },
    "practice": [
      "a0-03-s27",
      "a0-03-s28",
      "a0-03-s29",
      "a0-03-s32",
      "a0-03-s35"
    ]
  },
  "notes": {
    "sections": [
      {
        "id": "section-1",
        "title": "Инфинитив",
        "hint": "Начальная форма глагола — как русское «-ть»",
        "blocks": [
          {
            "type": "rule",
            "title": "Инфинитив",
            "pattern": [
              "-ar",
              "-er",
              "-ir"
            ],
            "text": "Инфинитив отвечает на вопрос «что делать?»",
            "examples": [
              {
                "es": "habl**ar**",
                "ru": "говорить",
                "ipa": "aˈblaɾ"
              },
              {
                "es": "com**er**",
                "ru": "есть",
                "ipa": "koˈmeɾ"
              },
              {
                "es": "dorm**ir**",
                "ru": "спать",
                "ipa": "doɾˈmiɾ"
              }
            ]
          }
        ]
      },
      {
        "id": "section-2",
        "title": "Хочу",
        "hint": "querer + инфинитив — как русское «хочу говорить»",
        "blocks": [
          {
            "type": "rule",
            "title": "querer + инфинитив",
            "pattern": [
              "querer",
              "+",
              "инфинитив"
            ],
            "text": "Меняется только первый глагол, второй стоит в инфинитиве.",
            "examples": [
              {
                "es": "**Quiero** hablar español.",
                "ru": "Я хочу говорить по-испански.",
                "ipa": "ˈkjeɾo aˈblaɾ espaˈɲol"
              },
              {
                "es": "¿**Quieres** trabajar?",
                "ru": "Ты хочешь работать?",
                "ipa": "ˈkjeɾes tɾabaˈxaɾ"
              },
              {
                "es": "No **quiero** estudiar.",
                "ru": "Я не хочу учиться.",
                "ipa": "no ˈkjeɾo estuˈdjaɾ"
              }
            ]
          },
          {
            "type": "conjugation",
            "verb": "querer",
            "ru": "хотеть",
            "rows": [
              {
                "stem": "quier",
                "ending": "o",
                "ipa": "ˈkjeɾo",
                "pronoun": "yo",
                "ru": "я хочу"
              },
              {
                "stem": "quier",
                "ending": "es",
                "ipa": "ˈkjeɾes",
                "pronoun": "tú",
                "ru": "ты хочешь"
              }
            ]
          },
          {
            "type": "words",
            "title": "Что я хочу делать",
            "headers": {
              "es": "Испанский",
              "ru": "Перевод"
